        target_content: "            {loading ? (\n              // Skeleton Loader\n              Array.from({ length: 6 }).map((_, i) => (\n                <div key={i} className=\"rounded-2xl border border-slate-100 bg-white shadow-sm flex flex-col overflow-hidden animate-pulse\">\n                  <div className=\"h-48 w-full bg-slate-200\"></div>\n                  <div className=\"p-6 flex flex-col gap-4\">\n                    <div className=\"flex justify-between items-start\">\n                      <div className=\"w-12 h-12 rounded-xl bg-slate-100\"></div>\n                      <div className=\"w-20 h-6 bg-slate-100 rounded-full\"></div>\n                    </div>\n                    <div className=\"space-y-3 mt-2\">\n                      <div className=\"w-1/2 h-6 bg-slate-100 rounded-md\"></div>\n                      <div className=\"w-3/4 h-4 bg-slate-100 rounded-md\"></div>\n                      <div className=\"w-full h-4 bg-slate-100 rounded-md mt-4\"></div>\n                    </div>\n                  </div>\n                </div>\n              ))\n            ) : (\n              categories.map((cat, idx) => {\n                const Icon = ICON_MAP[cat.icon] || Box;\n                return (\n                  <div \n                    key={idx} \n                    className=\"group rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-lg hover:border-brand-500/30 transition-all duration-300 flex flex-col overflow-hidden\"\n                  >\n                    <div className=\"h-48 w-full overflow-hidden bg-slate-100\">\n                      {cat.image && (\n                        <img \n                          src={cat.image} \n                          alt={cat.name} \n                          className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" \n                        />\n                      )}\n                    </div>\n                    <div className=\"p-6 flex flex-col flex-1\">\n                      <div className=\"flex justify-between items-start mb-4\">\n                        <div className=\"w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-300\">\n                          <Icon className=\"w-6 h-6\" strokeWidth={1.5} />\n                        </div>\n                        <span className={`px-3 py-1 text-xs font-semibold rounded-full ${\n                          cat.recyclable \n                            ? \'bg-emerald-100 text-emerald-700 border border-emerald-200/50\' \n                            : \'bg-slate-100 text-slate-600 border border-slate-200/50\'\n                        }`}>\n                          {cat.recyclable ? \'Recyclable\' : \'Trash\'}\n                        </span>\n                      </div>\n                      <h3 className=\"text-xl font-bold text-slate-900 mb-1\">{cat.name}</h3>\n                      <p className=\"text-sm text-slate-500 mb-4\">{cat.description}</p>\n                      <div className=\"mt-auto pt-4 border-t border-slate-100\">\n                        <p className=\"text-sm text-slate-600\">\n                          <span className=\"font-semibold text-slate-900\">Eco Tip:</span> {cat.tips}\n                        </p>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            )}"
        replacement_content: "            {loading ? (\n              // Skeleton Loader\n              Array.from({ length: 6 }).map((_, i) => (\n                <div key={i} className=\"rounded-2xl border border-slate-100 bg-white shadow-sm flex flex-col overflow-hidden animate-pulse\">\n                  <div className=\"h-48 w-full bg-slate-100/50\"></div>\n                  <div className=\"p-6 flex flex-col gap-4\">\n                    <div className=\"flex justify-between items-start\">\n                      <div className=\"w-12 h-12 rounded-xl bg-slate-100\"></div>\n                      <div className=\"w-20 h-6 bg-slate-100 rounded-full\"></div>\n                    </div>\n                    <div className=\"space-y-3 mt-2\">\n                      <div className=\"w-1/2 h-6 bg-slate-100 rounded-md\"></div>\n                      <div className=\"w-3/4 h-4 bg-slate-100 rounded-md\"></div>\n                      <div className=\"w-full h-4 bg-slate-100 rounded-md mt-4\"></div>\n                    </div>\n                  </div>\n                </div>\n              ))\n            ) : (\n              categories.map((cat: any, idx) => {\n                const Icon = ICON_MAP[cat.icon] || Package;\n                const themeStyles = THEME_MAP[cat.theme as keyof typeof THEME_MAP] || THEME_MAP.slate;\n                return (\n                  <div \n                    key={idx} \n                    className={`group rounded-2xl border transition-all duration-300 flex flex-col overflow-hidden shadow-sm hover:shadow-xl ${themeStyles.card}`}\n                  >\n                    <div className={`h-48 w-full flex items-center justify-center overflow-hidden ${themeStyles.imageBg}`}>\n                      {cat.image && (\n                        <img \n                          src={cat.image} \n                          alt={cat.name} \n                          className=\"w-32 h-32 object-contain group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-500 drop-shadow-md\" \n                        />\n                      )}\n                    </div>\n                    <div className=\"p-6 flex flex-col flex-1 bg-white/60 backdrop-blur-sm\">\n                      <div className=\"flex justify-between items-start mb-4\">\n                        <div className={`w-12 h-12 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 ${themeStyles.iconBg}`}>\n                          <Icon className=\"w-6 h-6\" strokeWidth={1.5} />\n                        </div>\n                        <span className={`px-3 py-1 text-xs font-semibold rounded-full ${\n                          cat.recyclable \n                            ? \'bg-emerald-100 text-emerald-700 border border-emerald-200/50\' \n                            : \'bg-slate-100 text-slate-600 border border-slate-200/50\'\n                        }`}>\n                          {cat.recyclable ? \'Recyclable\' : \'Trash\'}\n                        </span>\n                      </div>\n                      <h3 className=\"text-xl font-bold text-slate-900 mb-1\">{cat.name}</h3>\n                      <p className=\"text-sm text-slate-500 mb-4\">{cat.description}</p>\n                      <div className=\"mt-auto pt-4 border-t border-slate-100\">\n                        <p className=\"text-sm text-slate-600\">\n                          <span className=\"font-semibold text-slate-900\">Eco Tip:</span> {cat.tips}\n                        </p>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            )}"
