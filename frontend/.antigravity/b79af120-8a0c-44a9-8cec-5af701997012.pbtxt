  file_change {
    absolute_path_uri: "file:///src/views/Home.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { ArrowRight, Box, GlassWater, Coins, FileText, Container, Trash2 } from \'lucide-react\';\nimport { Link } from \'react-router-dom\';\nimport { useEffect, useState } from \'react\';\n\nconst LOCAL_CATEGORIES = [\n  { name: \"Cardboard\", description: \"Boxes, packaging\", icon: \"Box\", recyclable: true, tips: \"Flatten before recycling.\" },\n  { name: \"Glass\", description: \"Bottles, jars\", icon: \"GlassWater\", recyclable: true, tips: \"Rinse clean.\" },\n  { name: \"Metal\", description: \"Cans, foil\", icon: \"Coins\", recyclable: true, tips: \"Rinse food out.\" },\n  { name: \"Paper\", description: \"Newspapers\", icon: \"FileText\", recyclable: true, tips: \"Keep dry.\" },\n  { name: \"Plastic\", description: \"Bottles, bags\", icon: \"Container\", recyclable: true, tips: \"Check recycle number.\" },\n  { name: \"Trash\", description: \"Non-recyclable\", icon: \"Trash2\", recyclable: false, tips: \"Goes to landfill.\" }\n];\n\nconst ICON_MAP: Record<string, React.ElementType> = {\n  Box,\n  GlassWater,\n  Coins,\n  FileText,\n  Container,\n  Trash2\n};\n\nexport default function Home() {\n  const [categories, setCategories] = useState(LOCAL_CATEGORIES);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    // Simulate fetching from API, use local fallback\n    const fetchCategories = async () => {\n      setLoading(true);\n      try {\n        const url = import.meta.env.VITE_API_URL ? `${import.meta.env.VITE_API_URL}/categories` : \'\';\n        if (url) {\n          const res = await fetch(url);\n          if (res.ok) {\n            const data = await res.json();\n            setCategories(data);\n            return;\n          }\n        }\n      } catch (err) {\n        console.warn(\"API not accessible, using local categories fallback\", err);\n      } finally {\n        setTimeout(() => setLoading(false), 800); // Artificial delay to show nice skeleton\n      }\n    };\n\n    fetchCategories();\n  }, []);\n\n  return (\n    <div className=\"flex flex-col min-h-screen\">\n      {/* Hero Section */}\n      <section className=\"relative w-full overflow-hidden bg-emerald-950\">\n        <div className=\"absolute inset-0\">\n          <img \n            src=\"https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&q=80&w=2000\" \n            alt=\"Lush green canopy\" \n            className=\"w-full h-full object-cover object-center opacity-40 mix-blend-overlay\"\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-r from-emerald-950/90 to-teal-900/80\"></div>\n        </div>\n        \n        <div className=\"relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 flex flex-col items-center text-center\">\n          <h1 className=\"text-4xl md:text-5xl lg:text-7xl font-extrabold text-white tracking-tight mb-6\">\n            Know Your Waste, <br className=\"hidden md:block\"/> Heal the Planet\n          </h1>\n          <p className=\"text-lg md:text-xl text-emerald-50 max-w-2xl mb-10 font-medium\">\n            An advanced deep learning system powered by EfficientNetV2 to make garbage classification and recycling seamless.\n          </p>\n          <Link \n            to=\"/classify\"\n            className=\"group relative inline-flex items-center justify-center gap-2 bg-brand-500 hover:bg-brand-400 text-white px-8 py-4 rounded-full font-semibold text-lg transition-all shadow-[0_0_40px_-10px_rgba(16,185,129,0.8)] hover:shadow-[0_0_60px_-15px_rgba(16,185,129,1)] hover:-translate-y-0.5\"\n          >\n            Start Classifying\n            <ArrowRight className=\"w-5 h-5 transition-transform group-hover:translate-x-1\" />\n          </Link>\n        </div>\n      </section>\n\n      {/* Educational Hub */}\n      <section className=\"bg-white py-20\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid md:grid-cols-2 gap-12 lg:gap-20 items-center mb-24\">\n            <div className=\"rounded-2xl overflow-hidden shadow-xl shadow-slate-200/50 relative border border-slate-100\">\n              <img \n                src=\"https://images.unsplash.com/photo-1611284446314-60a58ac0deb9?auto=format&fit=crop&q=80&w=1000\" \n                alt=\"Source-level waste separation\" \n                className=\"w-full h-auto aspect-[4/3] object-cover\"\n              />\n              <div className=\"absolute inset-0 ring-1 ring-inset ring-black/10 rounded-2xl pointer-events-none\"></div>\n            </div>\n            <div>\n              <h2 className=\"text-3xl font-bold text-slate-900 mb-6 tracking-tight\">Why source-level separation matters.</h2>\n              <p className=\"text-slate-600 text-lg leading-relaxed mb-6\">\n                Sorting your waste accurately at the source is the single most effective way to reduce landfill burden and fight climate change. When materials are mixed, valuable recyclables become contaminated.\n              </p>\n              <p className=\"text-slate-600 text-lg leading-relaxed\">\n                Our AI classification system empowers everyday users to identify materials perfectly with a single snapshot, ensuring materials find their way back into the clean economy.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"text-center mb-12\">\n            <h2 className=\"text-3xl font-bold text-slate-900 tracking-tight mb-4\">Supported Categories</h2>\n            <p className=\"text-slate-500 max-w-2xl mx-auto\">\n              Our model currently identifies and provides disposal protocols for these common household waste types.\n            </p>\n          </div>\n\n          <div className=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n            {loading ? (\n              // Skeleton Loader\n              Array.from({ length: 6 }).map((_, i) => (\n                <div key={i} className=\"p-6 rounded-2xl border border-slate-100 bg-white shadow-sm flex flex-col gap-4 animate-pulse\">\n                  <div className=\"flex justify-between items-start\">\n                    <div className=\"w-12 h-12 rounded-xl bg-slate-100\"></div>\n                    <div className=\"w-20 h-6 bg-slate-100 rounded-full\"></div>\n                  </div>\n                  <div className=\"space-y-3 mt-2\">\n                    <div className=\"w-1/2 h-6 bg-slate-100 rounded-md\"></div>\n                    <div className=\"w-3/4 h-4 bg-slate-100 rounded-md\"></div>\n                    <div className=\"w-full h-4 bg-slate-100 rounded-md mt-4\"></div>\n                  </div>\n                </div>\n              ))\n            ) : (\n              categories.map((cat, idx) => {\n                const Icon = ICON_MAP[cat.icon] || Box;\n                return (\n                  <div \n                    key={idx} \n                    className=\"group p-6 rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-lg hover:border-brand-500/30 transition-all duration-300 flex flex-col\"\n                  >\n                    <div className=\"flex justify-between items-start mb-4\">\n                      <div className=\"w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-300\">\n                        <Icon className=\"w-6 h-6\" strokeWidth={1.5} />\n                      </div>\n                      <span className={`px-3 py-1 text-xs font-semibold rounded-full ${\n                        cat.recyclable \n                          ? \'bg-emerald-100 text-emerald-700 border border-emerald-200/50\' \n                          : \'bg-slate-100 text-slate-600 border border-slate-200/50\'\n                      }`}>\n                        {cat.recyclable ? \'Recyclable\' : \'Trash\'}\n                      </span>\n                    </div>\n                    <h3 className=\"text-xl font-bold text-slate-900 mb-1\">{cat.name}</h3>\n                    <p className=\"text-sm text-slate-500 mb-4\">{cat.description}</p>\n                    <div className=\"mt-auto pt-4 border-t border-slate-100\">\n                      <p className=\"text-sm text-slate-600\">\n                        <span className=\"font-semibold text-slate-900\">Eco Tip:</span> {cat.tips}\n                      </p>\n                    </div>\n                  </div>\n                );\n              })\n            )}\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n}\n"
    }
    diff {
      unified_diff {
