        target_content: "import { ArrowRight, Box, GlassWater, Coins, FileText, Container, Trash2 } from \'lucide-react\';\nimport { Link } from \'react-router-dom\';\nimport { useEffect, useState } from \'react\';\n\nconst LOCAL_CATEGORIES = [\n  { name: \"Cardboard\", description: \"Boxes, packaging\", icon: \"Box\", recyclable: true, tips: \"Flatten before recycling.\", image: \"https://images.unsplash.com/photo-1589824632832-21b6bd511ae2?auto=format&fit=crop&w=500&q=80\" },\n  { name: \"Glass\", description: \"Bottles, jars\", icon: \"GlassWater\", recyclable: true, tips: \"Rinse clean.\", image: \"https://images.unsplash.com/photo-1605273391740-b6daaaae1589?auto=format&fit=crop&w=500&q=80\" },\n  { name: \"Metal\", description: \"Cans, foil\", icon: \"Coins\", recyclable: true, tips: \"Rinse food out.\", image: \"https://images.unsplash.com/photo-1550989460-0adf9ea622e2?auto=format&fit=crop&w=500&q=80\" },\n  { name: \"Paper\", description: \"Newspapers\", icon: \"FileText\", recyclable: true, tips: \"Keep dry.\", image: \"https://images.unsplash.com/photo-1532153955177-f59af40d6472?auto=format&fit=crop&w=500&q=80\" },\n  { name: \"Plastic\", description: \"Bottles, bags\", icon: \"Container\", recyclable: true, tips: \"Check recycle number.\", image: \"https://images.unsplash.com/photo-1528323273322-d81458248d40?auto=format&fit=crop&w=500&q=80\" },\n  { name: \"Trash\", description: \"Non-recyclable\", icon: \"Trash2\", recyclable: false, tips: \"Goes to landfill.\", image: \"https://images.unsplash.com/photo-1595278069441-2cf29f8005a4?auto=format&fit=crop&w=500&q=80\" }\n];\n\nconst ICON_MAP: Record<string, React.ElementType> = {\n  Box,\n  GlassWater,\n  Coins,\n  FileText,\n  Container,\n  Trash2\n};"
        replacement_content: "import { ArrowRight, Package, GlassWater, Database, FileText, Beaker, Trash2 } from \'lucide-react\';\nimport { Link } from \'react-router-dom\';\nimport { useEffect, useState } from \'react\';\n\nconst LOCAL_CATEGORIES = [\n  { name: \"Cardboard\", description: \"Boxes, packaging\", icon: \"Package\", recyclable: true, tips: \"Flatten before recycling.\", image: \"https://img.icons8.com/color/256/open-box.png\", theme: \"amber\" },\n  { name: \"Glass\", description: \"Bottles, jars\", icon: \"GlassWater\", recyclable: true, tips: \"Rinse clean.\", image: \"https://img.icons8.com/color/256/wine-glass.png\", theme: \"cyan\" },\n  { name: \"Metal\", description: \"Cans, foil\", icon: \"Database\", recyclable: true, tips: \"Rinse food out.\", image: \"https://img.icons8.com/color/256/tin-can.png\", theme: \"zinc\" },\n  { name: \"Paper\", description: \"Newspapers\", icon: \"FileText\", recyclable: true, tips: \"Keep dry.\", image: \"https://img.icons8.com/color/256/paper.png\", theme: \"indigo\" },\n  { name: \"Plastic\", description: \"Bottles, bags\", icon: \"Beaker\", recyclable: true, tips: \"Check recycle number.\", image: \"https://img.icons8.com/color/256/plastic.png\", theme: \"pink\" },\n  { name: \"Trash\", description: \"Non-recyclable\", icon: \"Trash2\", recyclable: false, tips: \"Goes to landfill.\", image: \"https://img.icons8.com/color/256/trash-can.png\", theme: \"slate\" }\n];\n\nconst ICON_MAP: Record<string, React.ElementType> = {\n  Package,\n  GlassWater,\n  Database,\n  FileText,\n  Beaker,\n  Trash2\n};\n\nconst THEME_MAP = {\n  amber: {\n    card: \"bg-amber-50/20 border-amber-200 hover:border-amber-400/60 hover:shadow-amber-100\",\n    imageBg: \"bg-amber-100/50\",\n    iconBg: \"bg-amber-100 text-amber-600\",\n  },\n  cyan: {\n    card: \"bg-cyan-50/20 border-cyan-200 hover:border-cyan-400/60 hover:shadow-cyan-100\",\n    imageBg: \"bg-cyan-100/50\",\n    iconBg: \"bg-cyan-100 text-cyan-600\",\n  },\n  zinc: {\n    card: \"bg-zinc-50/20 border-zinc-200 hover:border-zinc-400/60 hover:shadow-zinc-100\",\n    imageBg: \"bg-zinc-100/50\",\n    iconBg: \"bg-zinc-100 text-zinc-600\",\n  },\n  indigo: {\n    card: \"bg-indigo-50/20 border-indigo-200 hover:border-indigo-400/60 hover:shadow-indigo-100\",\n    imageBg: \"bg-indigo-100/50\",\n    iconBg: \"bg-indigo-100 text-indigo-600\",\n  },\n  pink: {\n    card: \"bg-pink-50/20 border-pink-200 hover:border-pink-400/60 hover:shadow-pink-100\",\n    imageBg: \"bg-pink-100/50\",\n    iconBg: \"bg-pink-100 text-pink-600\",\n  },\n  slate: {\n    card: \"bg-slate-50/20 border-slate-200 hover:border-slate-400/60 hover:shadow-slate-100\",\n    imageBg: \"bg-slate-100/50\",\n    iconBg: \"bg-slate-100 text-slate-600\",\n  }\n};"
