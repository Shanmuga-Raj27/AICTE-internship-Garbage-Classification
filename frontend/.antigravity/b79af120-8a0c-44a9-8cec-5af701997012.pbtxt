  file_change {
    absolute_path_uri: "file:///src/views/Classifier.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useRef, useCallback } from \'react\';\nimport { UploadCloud, Camera, Scan, RotateCcw, AlertCircle, Loader2, CheckCircle2, XCircle, Info, ScanLine, Box, GlassWater, Coins, FileText, Container, Trash2 } from \'lucide-react\';\n\nconst CATEGORY_MAP: Record<string, any> = {\n  Cardboard: { icon: Box, recyclable: true, tips: \"Flatten before recycling.\" },\n  Glass: { icon: GlassWater, recyclable: true, tips: \"Rinse clean.\" },\n  Metal: { icon: Coins, recyclable: true, tips: \"Rinse food out.\" },\n  Paper: { icon: FileText, recyclable: true, tips: \"Keep dry.\" },\n  Plastic: { icon: Container, recyclable: true, tips: \"Check recycle number.\" },\n  Trash: { icon: Trash2, recyclable: false, tips: \"Goes to landfill.\" }\n};\n\ntype ClassificationStatus = \'idle\' | \'loading\' | \'success\' | \'error\';\n\nexport default function Classifier() {\n  const [imageSrc, setImageSrc] = useState<string | null>(null);\n  const [isCameraActive, setIsCameraActive] = useState(false);\n  const [status, setStatus] = useState<ClassificationStatus>(\'idle\');\n  const [result, setResult] = useState<any>(null);\n  const [errorMessage, setErrorMessage] = useState(\'\');\n\n  const videoRef = useRef<HTMLVideoElement>(null);\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const startCamera = async () => {\n    try {\n      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: \'environment\' } });\n      if (videoRef.current) {\n        videoRef.current.srcObject = stream;\n        videoRef.current.play();\n      }\n      setIsCameraActive(true);\n      setImageSrc(null);\n      setStatus(\'idle\');\n    } catch (err) {\n      console.error(\"Camera error:\", err);\n      setErrorMessage(\"Unable to access camera. Please check permissions or try uploading an image.\");\n      setStatus(\'error\');\n    }\n  };\n\n  const stopCamera = useCallback(() => {\n    if (videoRef.current && videoRef.current.srcObject) {\n      const stream = videoRef.current.srcObject as MediaStream;\n      stream.getTracks().forEach(track => track.stop());\n      videoRef.current.srcObject = null;\n    }\n    setIsCameraActive(false);\n  }, []);\n\n  const captureImage = () => {\n    if (videoRef.current && canvasRef.current) {\n      const video = videoRef.current;\n      const canvas = canvasRef.current;\n      canvas.width = video.videoWidth;\n      canvas.height = video.videoHeight;\n      const ctx = canvas.getContext(\'2d\');\n      if (ctx) {\n        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);\n        const dataUrl = canvas.toDataURL(\'image/jpeg\');\n        setImageSrc(dataUrl);\n        stopCamera();\n      }\n    }\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      const reader = new FileReader();\n      reader.onload = (event) => {\n        setImageSrc(event.target?.result as string);\n        setStatus(\'idle\');\n        stopCamera();\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const clearImage = () => {\n    setImageSrc(null);\n    setResult(null);\n    setStatus(\'idle\');\n  };\n\n  const simulateClassification = () => {\n    setStatus(\'loading\');\n    \n    // Simulate network/model inference latency\n    setTimeout(() => {\n      // Mock result randomly picked among known categories\n      const categories = Object.keys(CATEGORY_MAP);\n      const randomCatName = categories[Math.floor(Math.random() * categories.length)];\n      const conf = (Math.random() * (99.8 - 85.0) + 85.0).toFixed(1);\n\n      setResult({\n        category: randomCatName,\n        confidence: parseFloat(conf),\n        ...CATEGORY_MAP[randomCatName]\n      });\n      setStatus(\'success\');\n    }, 1500);\n  };\n\n  const ResultIcon = result?.icon || ScanLine;\n\n  return (\n    <div className=\"flex-1 bg-slate-50 py-10\">\n      <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"mb-8\">\n          <h1 className=\"text-2xl font-bold text-slate-900 tracking-tight\">AI Classification Model</h1>\n          <p className=\"text-slate-500 mt-1\">Upload or capture an image for immediate inference.</p>\n        </div>\n\n        <div className=\"grid lg:grid-cols-2 gap-8 items-start\">\n          \n          {/* Left Column: Input Source */}\n          <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-6\">\n            <h2 className=\"text-sm font-semibold text-slate-800 uppercase tracking-wider mb-6 flex items-center gap-2\">\n              <ScanLine className=\"w-4 h-4 text-brand-500\" />\n              Source Selection\n            </h2>\n\n            {!imageSrc && !isCameraActive && (\n              <div className=\"space-y-4\">\n                <div \n                  onClick={() => fileInputRef.current?.click()}\n                  className=\"border-2 border-dashed border-slate-300 rounded-xl p-10 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-slate-50 hover:border-brand-500 transition-colors group\"\n                >\n                  <div className=\"w-14 h-14 bg-slate-100 rounded-full flex items-center justify-center mb-4 group-hover:bg-brand-50 transition-colors\">\n                    <UploadCloud className=\"w-6 h-6 text-slate-500 group-hover:text-brand-600\" strokeWidth={1.5} />\n                  </div>\n                  <p className=\"font-medium text-slate-700 mb-1\">Click to Upload</p>\n                  <p className=\"text-xs text-slate-400\">Drag & drop or select from your device</p>\n                  <input \n                    type=\"file\" \n                    accept=\"image/*\" \n                    className=\"hidden\" \n                    ref={fileInputRef}\n                    onChange={handleFileUpload}\n                  />\n                </div>\n\n                <div className=\"flex items-center gap-4\">\n                  <div className=\"h-px bg-slate-200 flex-1\"></div>\n                  <span className=\"text-xs font-semibold text-slate-400 uppercase tracking-widest\">OR</span>\n                  <div className=\"h-px bg-slate-200 flex-1\"></div>\n                </div>\n\n                <button \n                  onClick={startCamera}\n                  className=\"w-full flex items-center justify-center gap-2 border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-medium py-3 px-4 rounded-xl transition-colors shadow-sm\"\n                >\n                  <Camera className=\"w-5 h-5 text-slate-500\" />\n                  Initialize Camera\n                </button>\n              </div>\n            )}\n\n            {isCameraActive && !imageSrc && (\n              <div className=\"space-y-4\">\n                <div className=\"relative rounded-xl overflow-hidden bg-slate-900 border border-slate-800 aspect-[4/3]\">\n                  <video \n                    ref={videoRef} \n                    className=\"w-full h-full object-cover\" \n                    playsInline \n                    autoPlay \n                    muted\n                  />\n                  <div className=\"absolute inset-0 ring-1 ring-inset ring-black/20 pointer-events-none\"></div>\n                </div>\n                <div className=\"flex gap-3\">\n                  <button \n                    onClick={captureImage}\n                    className=\"flex-1 bg-slate-900 hover:bg-slate-800 text-white font-medium py-3 px-4 rounded-xl transition-colors flex items-center justify-center gap-2 shadow-md\"\n                  >\n                    <Camera className=\"w-5 h-5\" />\n                    Capture Frame\n                  </button>\n                  <button \n                    onClick={stopCamera}\n                    className=\"px-4 py-3 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-50 font-medium transition-colors\"\n                  >\n                    Cancel\n                  </button>\n                </div>\n              </div>\n            )}\n\n            {imageSrc && (\n              <div className=\"space-y-6\">\n                <div className=\"relative rounded-xl overflow-hidden border border-slate-200 shadow-inner bg-slate-100 aspect-[4/3]\">\n                  <img src={imageSrc} alt=\"Captured to classify\" className=\"w-full h-full object-cover\" />\n                </div>\n                \n                {status !== \'loading\' && status !== \'success\' && (\n                  <div className=\"flex gap-3\">\n                    <button \n                      onClick={simulateClassification}\n                      className=\"flex-1 bg-brand-500 hover:bg-brand-600 text-white font-bold py-3.5 px-4 rounded-xl transition-colors flex items-center justify-center gap-2 shadow-md hover:shadow-lg\"\n                    >\n                      <Scan className=\"w-5 h-5\" />\n                      Classify Waste\n                    </button>\n                    <button \n                      onClick={clearImage}\n                      className=\"px-4 py-3 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-50 font-medium transition-colors flex items-center gap-2\"\n                    >\n                      Change\n                    </button>\n                  </div>\n                )}\n              </div>\n            )}\n\n          </div>\n\n          {/* Right Column: Analysis Results */}\n          <div className=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-6 min-h-[400px] flex flex-col relative\">\n             <h2 className=\"text-sm font-semibold text-slate-800 uppercase tracking-wider mb-6 flex items-center gap-2\">\n              <AlertCircle className=\"w-4 h-4 text-teal-600\" />\n              Analysis Results\n            </h2>\n\n            {status === \'idle\' && (\n              <div className=\"flex-1 flex flex-col items-center justify-center text-center text-slate-400 py-12\">\n                <ScanLine className=\"w-12 h-12 mb-4 text-slate-200\" strokeWidth={1} />\n                <p>Upload or capture an image to perform<br/>AI waste classification.</p>\n              </div>\n            )}\n\n            {status === \'loading\' && (\n              <div className=\"flex-1 flex flex-col items-center justify-center text-center py-12\">\n                <Loader2 className=\"w-10 h-10 animate-spin text-brand-500 mb-4\" />\n                <p className=\"text-slate-700 font-medium animate-pulse\">Running classification model paths...</p>\n                <p className=\"text-xs text-slate-400 mt-2 font-mono\">Analyzing spatial features & context</p>\n              </div>\n            )}\n\n            {status === \'error\' && (\n              <div className=\"bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl flex items-start gap-3\">\n                <XCircle className=\"w-5 h-5 mt-0.5 shrink-0\" />\n                <p className=\"text-sm font-medium\">{errorMessage}</p>\n              </div>\n            )}\n\n            {status === \'success\' && result && (\n              <div className=\"flex-1 flex flex-col animate-in fade-in slide-in-from-bottom-4 duration-500\">\n                <div className=\"flex items-center gap-4 mb-6\">\n                  <div className=\"w-16 h-16 bg-brand-50 border border-brand-100 rounded-2xl flex items-center justify-center text-brand-600\">\n                    <ResultIcon className=\"w-8 h-8\" strokeWidth={1.5} />\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-bold tracking-widest text-slate-400 uppercase mb-1\">Identified Material</p>\n                    <h3 className=\"text-3xl font-bold text-slate-900\">{result.category}</h3>\n                  </div>\n                </div>\n\n                <div className=\"mb-8\">\n                  <div className=\"flex justify-between items-end mb-2\">\n                    <span className=\"text-sm font-medium text-slate-600\">Model Confidence</span>\n                    <span className=\"text-sm font-bold font-mono text-slate-900\">{result.confidence}%</span>\n                  </div>\n                  <div className=\"h-2.5 w-full bg-slate-100 rounded-full overflow-hidden\">\n                    <div \n                      className=\"h-full bg-gradient-to-r from-emerald-400 to-teal-500 rounded-full transition-all duration-1000 ease-out origin-left\"\n                      style={{ width: `${result.confidence}%` }}\n                    ></div>\n                  </div>\n                </div>\n\n                <div className=\"bg-emerald-50 border border-emerald-100 rounded-2xl p-5 mb-8\">\n                  <h4 className=\"text-xs font-bold text-emerald-800 uppercase tracking-wider mb-4 flex items-center gap-2\">\n                    <Info className=\"w-4 h-4\" />\n                    Recycling Protocol\n                  </h4>\n                  \n                  <div className=\"flex items-start gap-4 mb-4\">\n                    <div className=\"shrink-0 mt-0.5\">\n                      {result.recyclable ? (\n                        <CheckCircle2 className=\"w-5 h-5 text-emerald-600\" />\n                      ) : (\n                        <XCircle className=\"w-5 h-5 text-slate-500\" />\n                      )}\n                    </div>\n                    <div>\n                      <p className=\"text-sm font-semibold text-emerald-950 mb-0.5\">\n                        {result.recyclable ? \'Acceptable for Recycling\' : \'Non-Recyclable Material\'}\n                      </p>\n                      <p className=\"text-sm text-emerald-700/80\">\n                        {result.recyclable ? \'This material can be processed by standard facilities.\' : \'Please dispose of this in standard waste bins.\'}\n                      </p>\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white/60 border border-emerald-200/50 rounded-xl p-3\">\n                    <p className=\"text-sm text-emerald-900\"><span className=\"font-semibold\">Action Required:</span> {result.tips}</p>\n                  </div>\n                </div>\n\n                <button \n                  onClick={clearImage}\n                  className=\"mt-auto w-full flex items-center justify-center gap-2 border-2 border-slate-200 hover:border-slate-300 bg-white text-slate-700 font-semibold py-3.5 px-4 rounded-xl transition-all shadow-sm hover:shadow\"\n                >\n                  <RotateCcw className=\"w-4 h-4\" />\n                  Scan Another Item\n                </button>\n              </div>\n            )}\n\n          </div>\n        </div>\n\n      </div>\n      {/* Hidden canvas for capturing images */}\n      <canvas ref={canvasRef} className=\"hidden\" />\n    </div>\n  );\n}\n"
    }
